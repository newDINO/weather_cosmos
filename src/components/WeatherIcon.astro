---
import { CONDITIONS } from '../lib/conditions';
import type { ConditionId } from '../lib/types';

interface Props {
  condition: ConditionId;
  size?: number;
  class?: string;
}

const { condition, size = 32, class: className = '' } = Astro.props;
const meta = CONDITIONS[condition];
const icon = meta.icon;
---

<svg
  class:list={['weather-icon', className]}
  width={size}
  height={size}
  viewBox="0 0 64 64"
  fill="none"
  stroke="currentColor"
  stroke-width="2.6"
  stroke-linecap="round"
  stroke-linejoin="round"
  style={`color:${meta.tone}`}
  aria-hidden="true"
>
  {icon === 'sun' && (
    <g>
      <circle cx="32" cy="32" r="10" />
      <path d="M32 8v6M32 50v6M8 32h6M50 32h6M15 15l4.5 4.5M44.5 44.5 49 49M49 15l-4.5 4.5M19.5 44.5 15 49" />
    </g>
  )}

  {icon === 'partly' && (
    <g>
      <circle cx="24" cy="23" r="7" />
      <path d="M24 9v4M24 33v4M10 23h4M34 23h4M14 13l3 3M31 30l3 3M34 13l-3 3" />
      <path d="M22 50h25a8 8 0 0 0 .7-15.9A11.5 11.5 0 0 0 25.4 30 8 8 0 0 0 22 50Z" />
    </g>
  )}

  {icon === 'cloud' && (
    <path d="M17 46h30a9 9 0 0 0 .8-18A13.5 13.5 0 0 0 21 25a9.5 9.5 0 0 0-4 21Z" />
  )}

  {icon === 'overcast' && (
    <g>
      <path d="M22 36h22a7.5 7.5 0 0 0 .5-14.9A11 11 0 0 0 24 19a8 8 0 0 0-2 17Z" />
      <path d="M14 50h32a9 9 0 0 0 .8-18A13 13 0 0 0 21 30a10 10 0 0 0-7 20Z" />
    </g>
  )}

  {icon === 'haze' && (
    <g>
      <path d="M12 22h34M20 30h32M10 38h32M18 46h34" />
      <path d="M12 54h20" opacity=".5" />
    </g>
  )}

  {icon === 'rain' && (
    <g>
      <path d="M18 38h28a8.5 8.5 0 0 0 .7-16.9A12.5 12.5 0 0 0 22 24a8.5 8.5 0 0 0-4 14Z" />
      <path d="M22 44l-3 9M33 44l-3 9M44 44l-3 9" />
    </g>
  )}

  {icon === 'storm' && (
    <g>
      <path d="M17 36h29a8.5 8.5 0 0 0 .7-16.9A12.5 12.5 0 0 0 22 22a8.5 8.5 0 0 0-5 14Z" />
      <path d="M34 39 27 50h7l-4 9 12-13h-7l3-7Z" fill="currentColor" fill-opacity=".18" />
    </g>
  )}

  {icon === 'snow' && (
    <g>
      <path d="M18 37h28a8.5 8.5 0 0 0 .7-16.9A12.5 12.5 0 0 0 22 23a8.5 8.5 0 0 0-4 14Z" />
      <path d="M21 46v8M17.5 48l7 4M24.5 48l-7 4M37 46v8M33.5 48l7 4M40.5 48l-7 4" />
    </g>
  )}

  {icon === 'dust' && (
    <g>
      <path d="M8 22c9-5 17-5 25 0M10 32c10-4 19-4 29 0M8 42c9-4 17-4 25 0M18 52c9-3 16-3 24 0" />
      <circle cx="46" cy="20" r="1.4" fill="currentColor" stroke="none" />
      <circle cx="52" cy="34" r="1.6" fill="currentColor" stroke="none" />
      <circle cx="40" cy="50" r="1.2" fill="currentColor" stroke="none" />
    </g>
  )}

  {icon === 'wind' && (
    <g>
      <path d="M10 24h27a6 6 0 1 0-6-6" />
      <path d="M8 34h35a6 6 0 1 1-6 6" />
      <path d="M14 44h20a5 5 0 1 1-5 5" opacity=".65" />
    </g>
  )}

  {icon === 'frost' && (
    <g>
      <path d="M32 10v44M13 21l38 22M51 21 13 43" />
      <path d="M26 15l6 6 6-6M26 49l6-6 6 6M18 27l8 1-1 8M46 28l-8 1 1 8M18 37l8-1-1-8M46 36l-8-1 1-8" opacity=".55" />
    </g>
  )}

  {icon === 'aurora' && (
    <g>
      <path d="M12 48c2-15 4-23 10-28M24 50c1-19 4-29 10-35M37 50c2-15 5-23 11-27" />
      <path d="M10 56h44" opacity=".35" />
      <circle cx="18" cy="15" r="1.3" fill="currentColor" stroke="none" />
      <circle cx="49" cy="28" r="1.3" fill="currentColor" stroke="none" />
    </g>
  )}

  {icon === 'volcano' && (
    <g>
      <path d="M8 54h48L41 26l-5 5-7-9L8 54Z" />
      <path d="M29 30c-2-5 4-6 3-11M37 28c1-4 6-4 5-9" opacity=".7" />
      <path d="M25 42h13" opacity=".5" />
    </g>
  )}

  {icon === 'geyser' && (
    <g>
      <path d="M10 54h44" />
      <path d="M25 48c-4-10-2-20 3-30M39 48c4-10 2-20-3-30M32 48V12" />
      <path d="M18 20c2 3 5 3 7 0M39 20c2 3 5 3 7 0" opacity=".6" />
    </g>
  )}

  {icon === 'sparkle' && (
    <g>
      <path d="M32 8l4.5 15.5L52 28l-15.5 4.5L32 48l-4.5-15.5L12 28l15.5-4.5L32 8Z" />
      <circle cx="49" cy="49" r="2" fill="currentColor" stroke="none" />
      <circle cx="14" cy="45" r="1.5" fill="currentColor" stroke="none" />
    </g>
  )}
</svg>
