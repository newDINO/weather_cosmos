---
import type { Body, Forecast } from '../lib/types';
import WeatherIcon from './WeatherIcon.astro';

interface Props {
  body: Body;
  forecast: Forecast;
}

const { body, forecast } = Astro.props;
const nowHour = Math.round(forecast.current.localHour) % 24;
// 从当前小时开始展示，让“现在”始终出现在列表首位（移动端无需横向拖动才能找到）
const hours = [...forecast.hourly.slice(nowHour), ...forecast.hourly.slice(0, nowHour)];
---

<section class="card hourly" aria-labelledby="hourly-title">
  <header class="card__head">
    <div>
      <h2 class="card__title" id="hourly-title">逐时预报</h2>
      <p class="card__subtitle">未来 1 个本地太阳日</p>
    </div>
    <span class="card__aside">本地时 · 横向滑动 →</span>
  </header>

  <ol class="hourly__list" tabindex="0" aria-label="未来一个本地日的逐时预报">
    {
      hours.map((hour) => (
        <li
          class:list={['hourly__item', { 'hourly__item--now': hour.hour === nowHour }]}
          aria-current={hour.hour === nowHour ? 'time' : undefined}
          data-hour={hour.hour}
        >
          <span class="hourly__time">{hour.hour === nowHour ? '现在' : hour.label}</span>
          <WeatherIcon condition={hour.condition} size={30} />
          <span class="hourly__event" title={`${body.climate.eventLabel} ${hour.eventPct}%`}>
            {hour.eventPct}%
          </span>
          <span class="hourly__temp">{hour.tempC}°</span>
        </li>
      ))
    }
  </ol>

  <p class="card__foot">
    “小时”为该天体本地太阳日的 24 等分；1 本地日 ≈ {body.dayLengthLabel}。百分比为{body.climate.eventLabel}。
  </p>
</section>
