---
import BodyCard from '../components/BodyCard.astro';
import LiveWeather from '../components/LiveWeather.astro';
import Orb from '../components/Orb.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { BODIES, MOONS, PLANETS } from '../data/bodies';
import { CONDITIONS } from '../lib/conditions';
import { BUILD_DATE } from '../lib/format';
import { BUILD_DATE_LABEL, url } from '../lib/site';
import { createForecast } from '../lib/simulate';
import type { Body } from '../lib/types';

const forecasts = new Map<Body, ReturnType<typeof createForecast>>(
  BODIES.map((body) => [body, createForecast(body, BUILD_DATE)]),
);

const earth = BODIES.find((body) => body.id === 'earth')!;
const earthForecast = forecasts.get(earth)!;
---

<BaseLayout
  title="星际天气 · 太阳系模拟天气预报"
  description="像看手机天气一样，查看水星、金星、火星、木星、土星、冥王星与著名卫星的天气。基于 NASA / ESA 真实观测参数、按浏览器本地时间生成的模拟预报。"
  active="home"
>
  <div class="container">
    <section class="home-hero">
      <div class="home-hero__copy">
        <p class="eyebrow">SOLAR SYSTEM WEATHER SERVICE</p>
        <h1>今天，<br />别的世界<br />天气如何？</h1>
        <p class="home-hero__lede">
          从水星没有大气的外逸层，到海王星的超音速风暴。基于 NASA / ESA
          实测参数，为 15 个天体生成模拟预报；打开页面时按你的本地日期重新计算。
        </p>
        <div class="home-hero__actions">
          <a class="button" href="#catalog">浏览全部天体</a>
          <a class="text-link" href={url('about/')}>预报是怎么来的？</a>
        </div>
        <p class="home-hero__meta">
          更新于 <time data-f="home-date" datetime={BUILD_DATE.toISOString()}>{BUILD_DATE_LABEL}</time>
          <span aria-hidden="true">·</span> 15 个天体
          <span aria-hidden="true">·</span> 按本地时间计算
        </p>
      </div>

      <div class="home-hero__art">
        <div class="home-hero__orbit" aria-hidden="true"></div>
        <Orb body={earth} size={300} class="home-hero__orb" />
        <div class="home-hero__now">
          <p class="home-hero__now-label">地球 · 参考浮标</p>
          <p class="home-hero__now-temp">
            <span data-f="earth-temp">{earthForecast.current.tempC}°</span>
            <span data-f="earth-condition">{CONDITIONS[earthForecast.current.condition].label}</span>
          </p>
        </div>
      </div>
    </section>

    <section class="catalog" id="catalog" aria-labelledby="planets-title">
      <header class="section-head">
        <h2 id="planets-title">行星与矮行星</h2>
        <p>8 颗行星，加上重新定义的冥王星</p>
      </header>
      <div class="body-grid">
        {
          PLANETS.map((body) => (
            <BodyCard body={body} forecast={forecasts.get(body)!} />
          ))
        }
      </div>
    </section>

    <section class="catalog" aria-labelledby="moons-title">
      <header class="section-head">
        <h2 id="moons-title">著名卫星</h2>
        <p>太阳系里最有“天气”的几颗卫星</p>
      </header>
      <div class="body-grid">
        {
          MOONS.map((body) => (
            <BodyCard body={body} forecast={forecasts.get(body)!} />
          ))
        }
      </div>
    </section>

    <section class="home-disclaimer card">
      <h2>这不是一份真实预报</h2>
      <p>
        没有任何机构能实时预测外星天气。这里给出的是“如果这些天体也有天气 App，它会显示什么”：
        温度、气压与风来自探测器与望远镜的长期观测统计，逐时变化和天气事件则是一个确定性的模拟。
      </p>
      <p>
        页面会在浏览器里按你的本地日期重算一次，不需要等站点重新构建；跨过本地午夜后，“今天”的天气也会自然更新。
      </p>
      <p>
        <a class="text-link" href={url('about/')}>阅读方法与数据来源 →</a>
      </p>
    </section>

    <LiveWeather />
  </div>
</BaseLayout>
